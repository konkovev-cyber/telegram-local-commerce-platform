# Environment Configuration (Example)
# Копировать в .env перед запуском

# Database (PostgreSQL 16)
POSTGRES_DB=telegram_commerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/telegram_commerce
DATABASE_POOL_SIZE=10

# Cache & Message Broker (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Security & Secrets
SECRET_KEY=development-secret-key-change-in-production-min-32-chars-long
# Fernet-ключ для симметричного шифрования токенов ботов (32 url-safe base64-encoded bytes)
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=vog7CBI3kEVUdhdebHkK0RSKrRb7D3ldhzFup8DBaQ4=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Telegram Bot Platform Settings
PLATFORM_BOT_TOKEN=1234567890:AAbbCCddEEffGGhhIIjjKKllMMnnOOppQQrr
TELEGRAM_BOT_SECRET=test-bot-secret-string

# Application Runtime
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
