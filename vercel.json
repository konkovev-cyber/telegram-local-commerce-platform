{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/proxy" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "buildCommand": "echo 'No build step needed — using pre-built dist'",
  "outputDirectory": ".",
  "framework": null,
  "env": {
    "BACKEND_URL": "http://localhost:8000"
  }
}
