{
  "buildCommand": "node -e \"require('fs').mkdirSync('.vercel/output', {recursive:true}); require('fs').copyFileSync('index.html', '.vercel/output/index.html'); require('fs').cpSync('assets', '.vercel/output/assets', {recursive:true}); require('fs').cpSync('api', '.vercel/output/api', {recursive:true})\"",
  "outputDirectory": ".vercel/output",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/proxy" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "BACKEND_URL": "http://localhost:8000"
  }
}
