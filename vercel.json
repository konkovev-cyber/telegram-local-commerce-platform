{
  "buildCommand": "npm run build",
  "outputDirectory": "/vercel/output",
  "framework": null,
  "devCommand": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/proxy" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "BACKEND_URL": "http://localhost:8000"
  }
}
